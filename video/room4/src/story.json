  "lines": [
    { "id": "L1", "speaker": "vikram", "start": 13.8, "end": 16.4, "text": "Aa gaye tum dono? Bahut saal ho gaye.", "tts": "आ गए तुम दोनों? बहुत साल हो गए।", "space": "outdoor" },
    { "id": "L2", "speaker": "karan", "start": 16.8, "end": 19.7, "text": "Bahut saal? We met him last month…", "tts": "बहुत साल? वी मेट हिम लास्ट मंथ।", "style": "aside", "space": "outdoor" },
    { "id": "L3", "speaker": "vikram", "start": 24.7, "end": 28.1, "text": "Ghar mein kahin bhi jao. Bas yeh kamra… kabhi mat kholna.", "tts": "घर में कहीं भी जाओ। बस यह कमरा... कभी मत खोलना।", "space": "hall" },
    { "id": "L4", "speaker": "rahul", "start": 28.35, "end": 29.95, "text": "Kyun? What's inside?", "tts": "क्यों? व्हाट्स इनसाइड?", "space": "hall" },
    { "id": "L5", "speaker": "vikram", "start": 30.15, "end": 31.9, "text": "Khana lag gaya hai.", "tts": "खाना लग गया है।", "space": "hall" },
    { "id": "L6", "speaker": "ghost", "start": 40.3, "end": 43.8, "text": "Rahul… Karan…", "tts": "राहुल... करन...", "style": "whisper", "space": "hall" },
    { "id": "L7", "speaker": "karan", "start": 44.9, "end": 46.6, "text": "Tune suna?", "tts": "तूने सुना?", "style": "aside", "space": "room" },
    { "id": "L7b", "speaker": "ghost", "start": 52.4, "end": 55.2, "text": "Rahul…", "tts": "राहुल...", "style": "whisper", "space": "hall" },
    { "id": "L8", "speaker": "karan", "start": 59.1, "end": 61.2, "text": "Mat khol, Rahul!", "tts": "मत खोल, राहुल!", "space": "hall" },
    { "id": "L9", "speaker": "rahul", "start": 76.4, "end": 79.6, "text": "Yeh… hum hain?", "tts": "ये... हम हैं?", "space": "room" },
    { "id": "L10", "speaker": "vikram", "start": 83.5, "end": 86.6, "text": "Tum log wapas aa gaye.", "tts": "तुम लोग वापस आ गए।", "style": "glitch", "space": "room" }
